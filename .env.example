# BuzzBee ERP · ejemplo de variables de entorno
# Copia sólo las variables necesarias a tu archivo .env real. Nunca subas secretos reales al repositorio.

# PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/buzzbee?schema=public"

# Autenticación
JWT_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"

# Seguridad del Super Admin / MFA
MFA_ENCRYPTION_KEY="reemplaza-con-un-secreto-distinto-y-largo"

# Integraciones cifradas
INTEGRATION_ENCRYPTION_KEY="reemplaza-con-un-secreto-distinto-y-largo"

# API / CORS
PORT=4000
CORS_ORIGIN="http://localhost:5173"
