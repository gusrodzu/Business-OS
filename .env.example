# BuzzBee ERP 18.2.0 — desarrollo local. Nunca subas .env con secretos reales.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public
JWT_SECRET=
MFA_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
CLIENT_URL=http://localhost:5173
TRUST_PROXY=

# Sesiones web: JWT únicamente dentro de cookies HttpOnly.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Compatibilidad temporal de Bearer para desarrollo. En producción debe ser false.
ALLOW_LEGACY_BEARER_AUTH=true

# Archivos privados. Desarrollo usa disco privado NO publicado por Express.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_DIR=
# Producción: PRIVATE_STORAGE_DRIVER=s3 y configura un bucket privado S3/R2.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=example-bucket
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
ALLOW_LOCAL_PRIVATE_STORAGE=false

# Sólo para archivos legacy locales; los uploads nuevos usan PRIVATE_STORAGE_DRIVER.
ALLOW_PUBLIC_LOCAL_UPLOADS=true

OPENAI_API_KEY=
BUZZBEE_AI_MODEL=gpt-5-mini
