{
  "name": "@erp/api",
  "private": true,
  "version": "19.2.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec node src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed-demo.js",
    "db:seed:demo-company": "node prisma/seed-demo-company-v8.js",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline:generate": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script -o prisma/migrations/0_init/migration.sql"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.5",
    "multer": "^2.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "6.15.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
