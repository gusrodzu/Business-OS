# BuzzBee ERP v18.2.0 — ejemplo de PRODUCCIÓN. Nunca uses estos placeholders como secretos.
# Dominio público del ERP, sin https://
APP_DOMAIN=erp.tudominio.com

# PostgreSQL incluido en docker-compose.production.yml
POSTGRES_USER=buzzbee_prod
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_ALEATORIO
POSTGRES_DB=buzzbee_prod

# Si usas docker-compose.production-managed-db.yml, configura DATABASE_URL y no necesitas POSTGRES_*.
DATABASE_URL=postgresql://usuario:password@host:5432/database?sslmode=require

# Seguridad API
JWT_SECRET=REEMPLAZAR_CON_MINIMO_48_CARACTERES_ALEATORIOS
MFA_ENCRYPTION_KEY=REEMPLAZAR_CON_MINIMO_32_CARACTERES_ALEATORIOS
INTEGRATION_ENCRYPTION_KEY=REEMPLAZAR_CON_MINIMO_32_CARACTERES_ALEATORIOS

# Sesión segura. Con Caddy del compose WEB/API comparten origen y Lax es suficiente.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ALLOW_LEGACY_BEARER_AUTH=false

# Storage privado S3/R2 obligatorio por defecto en producción.
PRIVATE_STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=buzzbee-private
S3_REGION=auto
S3_ACCESS_KEY_ID=REEMPLAZAR
S3_SECRET_ACCESS_KEY=REEMPLAZAR
S3_SESSION_TOKEN=
ALLOW_LOCAL_PRIVATE_STORAGE=false
ALLOW_PUBLIC_LOCAL_UPLOADS=false

# Opcional
OPENAI_API_KEY=
BUZZBEE_AI_MODEL=gpt-5-mini
